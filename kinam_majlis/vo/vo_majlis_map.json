{
 "phrases": [
  {
   "i": 1,
   "text": "الضيف يحكم على مجلسك من أول نفس",
   "start": 0.0,
   "end": 3.67
  },
  {
   "i": 2,
   "text": "قبل لا يجلس",
   "start": 3.99,
   "end": 5.17
  },
  {
   "i": 3,
   "text": "وقبل لا تصب له القهوة",
   "start": 5.32,
   "end": 6.83
  },
  {
   "i": 4,
   "text": "الريحة تسبقك",
   "start": 7.24,
   "end": 8.52
  },
  {
   "i": 5,
   "text": "ولما يكون بخورك كينام بيتهوفن",
   "start": 8.84,
   "end": 11.51
  },
  {
   "i": 6,
   "text": "أكيد بتسمع",
   "start": 11.74,
   "end": 13.02
  },
  {
   "i": 7,
   "text": "الله! وش هالطيب؟",
   "start": 13.41,
   "end": 15.65
  },
  {
   "i": 8,
   "text": "كينام طبيعي تريبل سوبر",
   "start": 16.06,
   "end": 18.45
  },
  {
   "i": 9,
   "text": "على الجمر يفوح عطره",
   "start": 18.7,
   "end": 20.86
  },
  {
   "i": 10,
   "text": "وأثره يبقى بالمجلس",
   "start": 21.07,
   "end": 22.97
  },
  {
   "i": 11,
   "text": "لأن الكرم يبدا من الريحة",
   "start": 23.19,
   "end": 25.75
  },
  {
   "i": 12,
   "text": "اطلبه الحين مع الضمان الذهبي من بيتهوفن",
   "start": 26.14,
   "end": 29.43
  },
  {
   "i": 13,
   "text": "وادفع عن طريق تابي أو تمارا",
   "start": 29.61,
   "end": 32.32
  }
 ]
}