{
 "phrases": [
  {
   "i": 1,
   "text": "جرّب الكينام من بيتهوفن",
   "start": 0.05,
   "end": 1.94
  },
  {
   "i": 2,
   "text": "وإذا ما ناسبك",
   "start": 2.31,
   "end": 3.23
  },
  {
   "i": 3,
   "text": "رجّعه",
   "start": 3.49,
   "end": 4.02
  },
  {
   "i": 4,
   "text": "ونرد لك كامل المبلغ",
   "start": 4.36,
   "end": 5.99
  },
  {
   "i": 5,
   "text": "بدون ما تذكر أي سبب",
   "start": 6.27,
   "end": 8.07
  },
  {
   "i": 6,
   "text": "هذا هو الضمان الذهبي من بيتهوفن",
   "start": 8.38,
   "end": 11.09
  },
  {
   "i": 7,
   "text": "كينام طبيعي",
   "start": 11.36,
   "end": 12.56
  },
  {
   "i": 8,
   "text": "تريبل سوبر",
   "start": 12.97,
   "end": 13.8
  },
  {
   "i": 9,
   "text": "من أفخم اختياراتنا",
   "start": 14.08,
   "end": 15.61
  },
  {
   "i": 10,
   "text": "على الجمر يطلع طابعه العطري",
   "start": 15.87,
   "end": 18.38
  },
  {
   "i": 11,
   "text": "ومعه لمسة بخورية دافية",
   "start": 18.71,
   "end": 20.82
  },
  {
   "i": 12,
   "text": "اختر الوزن اللي تبيه",
   "start": 21.08,
   "end": 22.64
  },
  {
   "i": 13,
   "text": "وادفع عن طريق تابي أو تمارا",
   "start": 22.99,
   "end": 25.25
  },
  {
   "i": 14,
   "text": "وعليه خصم جبار الحين",
   "start": 25.47,
   "end": 27.62
  },
  {
   "i": 15,
   "text": "لا يفوتك",
   "start": 27.94,
   "end": 28.85
  }
 ]
}