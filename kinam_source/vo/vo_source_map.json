{
 "phrases": [
  {
   "i": 1,
   "text": "مو كل عود",
   "start": 0.13,
   "end": 1.0
  },
  {
   "i": 2,
   "text": "يستاهل يوصل مجلسك",
   "start": 1.26,
   "end": 2.9
  },
  {
   "i": 3,
   "text": "في بيتهوفن",
   "start": 3.28,
   "end": 4.02
  },
  {
   "i": 4,
   "text": "الكينام يمر على يد خبير",
   "start": 4.28,
   "end": 6.14
  },
  {
   "i": 5,
   "text": "قبل لا يوصلك",
   "start": 6.39,
   "end": 7.45
  },
  {
   "i": 6,
   "text": "نفرزه قطعة قطعة",
   "start": 7.83,
   "end": 9.61
  },
  {
   "i": 7,
   "text": "نشوف كثافته ولمعة دهنه",
   "start": 9.86,
   "end": 12.28
  },
  {
   "i": 8,
   "text": "وعروق خشبه",
   "start": 12.54,
   "end": 13.57
  },
  {
   "i": 9,
   "text": "ونجربه على الجمر",
   "start": 13.83,
   "end": 15.21
  },
  {
   "i": 10,
   "text": "واللي ما يطابق معيارنا",
   "start": 15.6,
   "end": 17.32
  },
  {
   "i": 11,
   "text": "ما يدخل العلبة",
   "start": 17.58,
   "end": 18.71
  },
  {
   "i": 12,
   "text": "وهذا اللي يخلي كينام بيتهوفن",
   "start": 19.09,
   "end": 21.53
  },
  {
   "i": 13,
   "text": "تريبل سوبر",
   "start": 21.79,
   "end": 22.67
  },
  {
   "i": 14,
   "text": "من أفخم اختياراتنا",
   "start": 22.93,
   "end": 24.45
  },
  {
   "i": 15,
   "text": "من المصدر",
   "start": 24.83,
   "end": 25.76
  },
  {
   "i": 16,
   "text": "لين مجلسك",
   "start": 26.02,
   "end": 26.97
  },
  {
   "i": 17,
   "text": "اطلبه الحين مع الضمان الذهبي من بيتهوفن",
   "start": 27.36,
   "end": 30.55
  },
  {
   "i": 18,
   "text": "وادفع عن طريق تابي أو تمارا",
   "start": 30.94,
   "end": 33.45
  }
 ]
}